#!/usr/bin/env python3
"""ty — same entry point from PATH, a skill directory or a source checkout."""
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
sys.dont_write_bytecode = True

# An explicit interpreter wins over the installer selection, then a local venv.
# Compare executable paths, not realpaths: a venv may symlink the system Python.
selected = os.environ.get("TANYUAN_PYTHON")
if not selected and (ROOT / ".python").is_file():
    selected = (ROOT / ".python").read_text(encoding="utf-8").strip()
if not selected and (ROOT / ".venv" / "bin" / "python").is_file():
    selected = str(ROOT / ".venv" / "bin" / "python")
if selected:
    interpreter = Path(selected).expanduser()
    if not interpreter.is_absolute():
        raise SystemExit("ty: TANYUAN_PYTHON 必须是绝对路径。")
    interpreter = Path(os.path.abspath(interpreter))
    if not interpreter.is_file() or not os.access(interpreter, os.X_OK):
        raise SystemExit("ty: Python 解释器必须是可执行文件的绝对路径，请重新安装或设置 TANYUAN_PYTHON。")
    if os.path.abspath(sys.executable) != str(interpreter):
        os.execv(str(interpreter), [str(interpreter), str(Path(__file__).resolve()), *sys.argv[1:]])

try:
    import requests  # noqa: F401
except ModuleNotFoundError:
    raise SystemExit(
        "ty: 缺少依赖 requests。请运行交付包 install.py，"
        "或设置 TANYUAN_PYTHON 为已安装 requirements.txt 依赖的 Python 绝对路径。"
    )

from tanyuan.cli import main  # noqa: E402

sys.exit(main(sys.argv[1:]))
